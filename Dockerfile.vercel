
FROM dunglas/frankenphp:1-php8.4-alpine

WORKDIR /app

# Install PHP extensions required by your existing application
RUN install-php-extensions curl xml mbstring

# Create the website directory
RUN mkdir -p /app/public/data

# Copy the existing website and PHP backend
COPY index.html auth.php bible.php chapters.php verse.php /app/public/

# Copy the Bible XML search database
COPY data/eng-asv.zefania.xml /app/public/data/eng-asv.zefania.xml

# Configure the web server
COPY Caddyfile /etc/caddy/Caddyfile

ENV PORT=80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
